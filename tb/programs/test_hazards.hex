// ============================================================================
// File: test_hazards.hex
// Description: Comprehensive RV32I Test Program in 32-bit Hex words.
// Test coverage:
//   - EX->EX & MEM->EX data forwarding (ADD, SUB, OR)
//   - L1 D-Cache Clean Line Refills
//   - L1 D-Cache Conflict Misses & 2-Way Set-Associative Replacement
//   - L1 D-Cache Dirty Line Evictions (32-byte AXI burst writebacks)
//   - L1 D-Cache Data Persistence Verification across Evictions & Refills
//   - Load-Use hazard 1-cycle pipeline interlock
//   - Branch Not-Taken sequential continuation
//   - Branch Taken control hazard pipeline flush
//   - JAL jump & link redirection with return address linking
//   - Pass criteria:
//       Register x10 == 32'd42 (0x0000002A)
//       Register x11 == 32'd40 (0x00000028 from evicted/re-read cache line)
//       Register x8  == 32'd42
//       Register x7  == 32'd30 (from evicted/re-read cache line)
// ============================================================================
@00000000
00a00093 // 0x00: ADDI x1, x0, 10
01400113 // 0x04: ADDI x2, x0, 20
002081b3 // 0x08: ADD x3, x1, x2
40118233 // 0x0c: SUB x4, x3, x1
003262b3 // 0x10: OR x5, x4, x3
00001637 // 0x14: LUI x12, 1 (0x1000)
000026b7 // 0x18: LUI x13, 2 (0x2000)
00003737 // 0x1c: LUI x14, 3 (0x3000)
00562023 // 0x20: SW x5, 0(x12) [Dirty Way 0 with 30]
02800793 // 0x24: ADDI x15, x0, 40
00f6a023 // 0x28: SW x15, 0(x13) [Dirty Way 1 with 40]
03200813 // 0x2c: ADDI x16, x0, 50
01072023 // 0x30: SW x16, 0(x14) [Evicts Way 0 (0x1000) to AXI RAM!]
00062383 // 0x34: LW x7, 0(x12) [Refills evicted 0x1000: x7 must be 30!]
00c38413 // 0x38: ADDI x8, x7, 12 [LOAD-USE STALL: x8 = 42!]
00208863 // 0x3c: BEQ x1, x2, +16
00100493 // 0x40: ADDI x9, x0, 1
00209663 // 0x44: BNE x1, x2, +12 (Taken)
00000413 // 0x48: ADDI x8, x0, 0 (Flush 1)
00000413 // 0x4c: ADDI x8, x0, 0 (Flush 2)
00c000ef // 0x50: JAL x1, +12
00000413 // 0x54: ADDI x8, x0, 0 (Flush 3)
00000413 // 0x58: ADDI x8, x0, 0 (Flush 4)
00040513 // 0x5c: ADDI x10, x8, 0 (x10 = 42)
0006a583 // 0x60: LW x11, 0(x13) [Refills evicted 0x2000: x11 must be 40!]
0000006f // 0x64: JAL x0, 0 [HALT at PC 0x64]
